{
   "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
   "tasks": [
      {
         "name": "validate-changelog",
         "command": "dotnet",
         "args": [ "fsi", "scripts/validate-changelog.fsx" ]
      },
      {
         "name": "format-check",
         "command": "bash",
         "args": [ "build.sh", "--target", "Precommit" ],
         "windows": {
            "command": "cmd",
            "args": [ "/c", "build.cmd", "--target", "Precommit" ]
         }
      },
      {
         "name": "agent-skill-copies",
         "command": "dotnet",
         "args": [ "fsi", "scripts/sync-agent-skills.fsx", "--check" ],
         "filteringRule": "staged",
         "include": [ ".agents/skills/**", ".claude/skills/**", ".grok/skills/**", "scripts/sync-agent-skills.fsx" ]
      }
   ]
}
