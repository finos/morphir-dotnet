{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morphir configuration inspection result",
  "description": "The source-generated ConfigurationReport envelope. Canonical JSON values are typed; sensitive values are redacted before serialization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "scope",
    "key",
    "found",
    "value",
    "entries",
    "sources",
    "contributions",
    "diagnostics",
    "valueTypes",
    "exitCode"
  ],
  "properties": {
    "operation": {
      "enum": [
        "config",
        "get",
        "list",
        "show",
        "path",
        "explain"
      ]
    },
    "scope": {
      "anyOf": [
        {
          "enum": [
            "effective",
            "workspace",
            "project",
            "user",
            "global",
            "system"
          ]
        },
        {
          "type": "string",
          "pattern": "^file:"
        }
      ]
    },
    "key": {
      "type": [
        "string",
        "null"
      ]
    },
    "found": {
      "type": "boolean"
    },
    "value": {},
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceReport"
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contribution"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "exitCode": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "valueTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/valueType"
      }
    },
    "containment": {
      "$ref": "#/$defs/containment"
    }
  },
  "$defs": {
    "containment": {
      "description": "Effective discovery boundary and isolation, reported by config path.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "boundarySource",
        "isolated",
        "isolationSource"
      ],
      "properties": {
        "boundary": {
          "type": "string"
        },
        "boundarySource": {
          "$ref": "#/$defs/containmentSource"
        },
        "isolated": {
          "type": "boolean"
        },
        "isolationSource": {
          "$ref": "#/$defs/containmentSource"
        }
      }
    },
    "containmentSource": {
      "enum": [
        "flag",
        "environment",
        "default"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "role",
        "order",
        "profile"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "enum": [
            "",
            "json",
            "yaml",
            "toml",
            "memory"
          ]
        },
        "role": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "profile": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "source",
        "line",
        "column"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "column": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value",
        "origins"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {},
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/origin"
          }
        }
      }
    },
    "sourceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "contributed",
        "detail"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "status": {
          "enum": [
            "loaded",
            "missing",
            "skipped",
            "failed"
          ]
        },
        "contributed": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "value",
        "winner",
        "origins"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "value": {},
        "winner": {
          "type": "boolean"
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/origin"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message",
        "path",
        "key",
        "line",
        "column"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ]
        },
        "column": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "valueType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer",
        "kind",
        "encoding"
      ],
      "properties": {
        "pointer": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "number",
            "temporal"
          ]
        },
        "encoding": {
          "type": "string"
        }
      }
    }
  }
}
