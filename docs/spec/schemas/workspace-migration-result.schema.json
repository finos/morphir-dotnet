{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphir.finos.org/schemas/workspace-migration-result.schema.json",
  "title": "Bounded workspace migration result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "outcome",
    "rootPath",
    "rootIsProject",
    "changed",
    "dryRun",
    "verified",
    "inventory",
    "projects",
    "members",
    "workspaceTarget",
    "workspaceEdits",
    "adoptionEffects",
    "diagnostics",
    "recoveryArtifacts",
    "restoredPaths",
    "unresolvedPaths",
    "exitCode",
    "valueTypes",
    "uncertainDirectories",
    "preservedDirectories"
  ],
  "properties": {
    "operation": {
      "const": "workspace-migrate"
    },
    "outcome": {
      "enum": [
        "preview",
        "written",
        "unchanged",
        "blocked",
        "conflict",
        "rolled-back",
        "recovery-required",
        "io-failure"
      ]
    },
    "rootPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "rootIsProject": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "dryRun": {
      "type": "boolean"
    },
    "verified": {
      "type": "boolean"
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "relativePath",
          "kind",
          "reason",
          "name"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "relativePath": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "Candidate",
              "Excluded",
              "Boundary",
              "AlreadyMigrated",
              "LinkSkipped"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectReport"
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workspaceTarget": {
      "type": [
        "string",
        "null"
      ]
    },
    "workspaceEdits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectReport/$defs/edit"
      }
    },
    "adoptionEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projectPath",
          "kind",
          "before",
          "after"
        ],
        "properties": {
          "projectPath": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "before": {
            "type": [
              "string",
              "null"
            ]
          },
          "after": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectReport/$defs/diagnostic"
      }
    },
    "recoveryArtifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectReport/$defs/artifact"
      }
    },
    "restoredPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolvedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exitCode": {
      "enum": [
        0,
        2
      ]
    },
    "valueTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectReport/$defs/valueType"
      }
    },
    "uncertainDirectories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preservedDirectories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "projectReport": {
      "title": "Single project migration result",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "outcome",
        "projectPath",
        "source",
        "target",
        "changed",
        "dryRun",
        "ledger",
        "edits",
        "verification",
        "diagnostics",
        "recoveryArtifacts",
        "exitCode",
        "valueTypes",
        "conflicts"
      ],
      "properties": {
        "operation": {
          "const": "migrate"
        },
        "outcome": {
          "enum": [
            "preview",
            "written",
            "unchanged",
            "blocked",
            "conflict",
            "rolled-back",
            "recovery-required",
            "io-failure"
          ]
        },
        "projectPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/projectReport/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/projectReport/$defs/source"
            },
            {
              "type": "null"
            }
          ]
        },
        "changed": {
          "type": "boolean"
        },
        "dryRun": {
          "type": "boolean"
        },
        "ledger": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectReport/$defs/field"
          }
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectReport/$defs/edit"
          }
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/projectReport/$defs/verification"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectReport/$defs/diagnostic"
          }
        },
        "recoveryArtifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectReport/$defs/artifact"
          }
        },
        "exitCode": {
          "enum": [
            0,
            2
          ]
        },
        "valueTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectReport/$defs/valueType"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "sourceValue",
              "targetValue",
              "source",
              "target"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "sourceValue": {},
              "targetValue": {},
              "source": {
                "$ref": "#/$defs/projectReport/$defs/source"
              },
              "target": {
                "$ref": "#/$defs/projectReport/$defs/source"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "$defs": {
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "format",
            "role",
            "order",
            "profile"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "order": {
              "type": "integer"
            },
            "profile": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "field": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rawPath",
            "canonicalPath",
            "value",
            "disposition"
          ],
          "properties": {
            "rawPath": {
              "type": "string"
            },
            "canonicalPath": {
              "type": [
                "string",
                "null"
              ]
            },
            "value": {},
            "disposition": {
              "enum": [
                "mapped",
                "retained",
                "blocking",
                "derived"
              ]
            }
          }
        },
        "edit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "value"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "value": {}
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verified",
            "before",
            "after",
            "differences",
            "originChanges",
            "baseWorkspace"
          ],
          "properties": {
            "verified": {
              "type": "boolean"
            },
            "before": {},
            "after": {},
            "differences": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/projectReport/$defs/difference"
              }
            },
            "originChanges": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/projectReport/$defs/originChange"
              }
            },
            "baseWorkspace": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "root",
                "outputDirectory"
              ],
              "properties": {
                "root": {
                  "type": "string"
                },
                "outputDirectory": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "difference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "before",
            "after",
            "beforePath",
            "afterPath"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "before": {},
            "after": {},
            "beforePath": {
              "type": [
                "string",
                "null"
              ]
            },
            "afterPath": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "source",
            "line",
            "column"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/projectReport/$defs/source"
            },
            "line": {
              "type": [
                "integer",
                "null"
              ]
            },
            "column": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "originChange": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "before",
            "after"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "before": {
              "anyOf": [
                {
                  "$ref": "#/$defs/projectReport/$defs/origin"
                },
                {
                  "type": "null"
                }
              ]
            },
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/projectReport/$defs/origin"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "diagnostic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "severity",
            "message",
            "path",
            "key",
            "line",
            "column"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "severity": {
              "enum": [
                "error",
                "warning"
              ]
            },
            "message": {
              "type": "string"
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "key": {
              "type": [
                "string",
                "null"
              ]
            },
            "line": {
              "type": [
                "integer",
                "null"
              ]
            },
            "column": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "kind",
            "transactionId"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "transactionId": {
              "type": "string"
            }
          }
        },
        "valueType": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pointer",
            "kind",
            "encoding"
          ],
          "properties": {
            "pointer": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "encoding": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
