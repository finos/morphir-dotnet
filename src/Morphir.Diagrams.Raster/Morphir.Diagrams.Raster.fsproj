<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(MorphirLibraryTargetFrameworks)</TargetFrameworks>
        <Description>Converts Morphir.Diagrams SVG to PNG, JPEG and animated GIF in managed code.</Description>
        <PackageTags>$(PackageTags);diagrams;png;jpeg;gif</PackageTags>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <!-- Morphir.Diagrams.Slides warns when its PNG fallbacks approximate paint, with the painter's own check. -->
        <InternalsVisibleTo Include="Morphir.Diagrams.Slides" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <ProjectReference Include="../Morphir.Diagrams/Morphir.Diagrams.fsproj" />
        <Compile Include="Geometry.fs" />
        <Compile Include="Fonts.fs" />
        <Compile Include="Canvas.fs" />
        <Compile Include="SvgPainter.fs" />
        <Compile Include="Encoders.fs" />
        <Compile Include="Raster.fs" />
        <EmbeddedResource Include="Fonts/regular.ttf" LogicalName="Morphir.Diagrams.Raster.Fonts.regular.ttf" />
        <EmbeddedResource Include="Fonts/bold.ttf" LogicalName="Morphir.Diagrams.Raster.Fonts.bold.ttf" />
        <EmbeddedResource Include="Fonts/symbols.ttf" LogicalName="Morphir.Diagrams.Raster.Fonts.symbols.ttf" />
        <None Include="Fonts/OFL.txt" Pack="true" PackagePath="licenses/fonts/" />
        <None Include="Fonts/PROVENANCE.md" Pack="true" PackagePath="licenses/fonts/" />
        <None Include="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    </ItemGroup>
</Project>
