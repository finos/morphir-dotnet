<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(MorphirLibraryTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Morphir.IR.Pipeline.Plugins</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Pipeline plugins for Morphir IR packages: optimizer, type validator, exact scalar folding and pretty printer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ClassicPackage.fs" />
    <Compile Include="TypeValidator.fs" />
    <Compile Include="ExactScalarFolding.fs" />
    <Compile Include="Optimizer.fs" />
    <Compile Include="PrettyPrinter.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Morphir.IR.Pipeline\Morphir.IR.Pipeline.fsproj" />
    <ProjectReference Include="..\Morphir.Models\Morphir.Models.fsproj" />
  </ItemGroup>

</Project>
