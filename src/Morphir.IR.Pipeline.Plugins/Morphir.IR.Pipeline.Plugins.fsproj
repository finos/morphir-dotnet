<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Morphir.IR.Pipeline.Plugins</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="TypeValidator.fs" />
    <Compile Include="Optimizer.fs" />
    <Compile Include="PrettyPrinter.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Morphir.IR.Pipeline\Morphir.IR.Pipeline.fsproj" />
    <ProjectReference Include="..\Morphir.Models\Morphir.Models.fsproj" />
  </ItemGroup>

</Project>
