<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!--
      Every shipped project takes its version from CHANGELOG.md, so all Morphir
      assemblies in a release carry the same version and reference each other at it.
    -->
    <ItemGroup>
        <PackageReference Include="Ionide.KeepAChangelog.Tasks" PrivateAssets="all" />
    </ItemGroup>

    <!--
      An explicit -p:Version or -p:PackageVersion wins over CHANGELOG.md, so local and
      test builds can pack a throwaway version into an isolated feed. The changelog task
      would otherwise overwrite it. Release builds pass neither.
    -->
    <PropertyGroup Condition="'$(Version)' != '' or '$(PackageVersion)' != ''">
        <ChangelogFile></ChangelogFile>
        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);CNG0001</MSBuildWarningsAsMessages>
    </PropertyGroup>

    <!--
      A self-contained process publish (PublishProfile=SelfContainedProcess, which reaches every project of the
      publish) restores for one runtime identifier, and NuGet would add a section for that RID to each committed
      packages.lock.json. Write those lock files under obj/ instead. Package versions stay pinned centrally in
      Directory.Packages.props. Other builds and publishes keep the committed lock files.
    -->
    <PropertyGroup Condition="'$(PublishProfile)' == 'SelfContainedProcess' and '$(RuntimeIdentifier)' != ''">
        <NuGetLockFilePath>$(MSBuildProjectDirectory)/obj/publish-lock/$(RuntimeIdentifier)/packages.lock.json</NuGetLockFilePath>
    </PropertyGroup>
</Project>
