<!--
  An application publish passes PublishAot, PublishTrimmed and PublishSingleFile as global properties, which also reach
  the netstandard2.0 target of this library (for example dotnet publish src/Morphir -p:PublishAot=true). The SDK refuses
  them for netstandard2.0 (NETSDK1207), so that target keeps them local and off. The other targets keep the values of the
  publish. The application still compiles and trims this assembly.
-->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed;PublishSingleFile">

    <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
    </PropertyGroup>

    <PropertyGroup>
        <!-- netstandard2.0: the source generator and the MSBuild target of Morphir.Lang.CSharp load this assembly in a compiler host. -->
        <TargetFrameworks>$(MorphirLibraryTargetFrameworks);netstandard2.0</TargetFrameworks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Morphir</RootNamespace>
        <Description>Morphir IR model definitions in F#</Description>
        <PackageReleaseNotes>### Added
Typed classic and v4 Morphir IR models with source-version preservation for in-memory backend consumers.</PackageReleaseNotes>
        <PackageTags>$(PackageTags);morphir;fsharp;ir</PackageTags>
        <!-- C# callers read the nullable metadata that F# nullness writes. Without it, C# sees these types as oblivious. -->
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- Trimming and AOT analyzers for the frameworks that support them. netstandard2.0 supports neither (NETSDK1210, NETSDK1212). -->
    <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <!-- Virtual files and trees, which the document-tree store of the model reads and writes without touching the disk. -->
    <ItemGroup>
        <ProjectReference Include="..\Morphir.Files\Morphir.Files.fsproj" />
    </ItemGroup>

    <!-- netstandard2.0 has no System.Text.Json and lacks some members of newer frameworks; Polyfill.fs adds them. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Text.Json" />
        <Compile Include="Polyfill.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="IR/Name.fs" />
        <Compile Include="IR/Path.fs" />
        <Compile Include="IR/PackageName.fs" />
        <Compile Include="IR/ModulePath.fs" />
        <Compile Include="IR/FQName.fs" />
        <Compile Include="IR/QName.fs" />
        <Compile Include="IR/CanonicalNames.fs" />
        <Compile Include="IR/Versioning.fs" />
        <Compile Include="IR/Classic/AccessControlled.fs" />
        <Compile Include="IR/Classic/Type.fs" />
        <Compile Include="IR/Classic/Literal.fs" />
        <Compile Include="IR/Classic/Pattern.fs" />
        <Compile Include="IR/Classic/Value.fs" />
        <Compile Include="IR/Classic/Aliases.fs" />
        <Compile Include="IR/Classic/Documented.fs" />
        <Compile Include="IR/Classic/Module.fs" />
        <Compile Include="IR/Classic/Package.fs" />
        <Compile Include="IR/Classic/Distribution.fs" />
        <Compile Include="IR/Classic/Attributes.fs" />
        <Compile Include="IR/Classic/DSL/Helpers.fs" />
        <Compile Include="IR/Classic/DSL/Types.fs" />
        <Compile Include="IR/Classic/DSL/Values.fs" />
        <Compile Include="IR/Classic/DSL/Patterns.fs" />
        <Compile Include="IR/Classic/DSL/Literals.fs" />
        <Compile Include="IR/Classic/DSL/Modules.fs" />
        <Compile Include="IR/Classic/DSL/Packages.fs" />
        <Compile Include="IR/Classic/DSL/Distributions.fs" />
        <Compile Include="IR/V4/OrderedMap.fs" />
        <Compile Include="IR/V4/Common.fs" />
        <Compile Include="IR/V4/Literal.fs" />
        <Compile Include="IR/V4/Type.fs" />
        <Compile Include="IR/V4/Value.fs" />
        <Compile Include="IR/V4/Module.fs" />
        <Compile Include="IR/V4/Distribution.fs" />
        <Compile Include="IR/VersionedModel.fs" />
        <Compile Include="IR/Trees/TreeStems.fs" />
        <Compile Include="IR/Trees/DocumentAddress.fs" />
        <Compile Include="IR/Trees/DocumentTree.fs" />
        <Compile Include="IR/Trees/TreeJoin.fs" />
        <Compile Include="IR/Trees/V4DocumentTree.fs" />
        <Compile Include="IR/Trees/ClassicDocumentTree.fs" />
        <Compile Include="IR/DSL/Names.fs" />
        <Compile Include="IR/DSL/DSL.fs" />
        <Compile Include="Json/MorphirJsonOptions.fs" />
        <Compile Include="Json/Encode.fs" />
        <Compile Include="Json/Decode.fs" />
        <Compile Include="Json/CanonicalJson.fs" />
        <Compile Include="Json/Codecs/NameCodec.fs" />
        <Compile Include="Json/Codecs/PathCodec.fs" />
        <Compile Include="Json/Codecs/FQNameCodec.fs" />
        <Compile Include="Json/Codecs/LiteralCodec.fs" />
        <Compile Include="Json/Codecs/TypeCodec.fs" />
        <Compile Include="Json/Codecs/RawTypeCodec.fs" />
        <Compile Include="Json/Classic/ClassicJson.fs" />
        <Compile Include="Json/Classic/ClassicJsonWriter.fs" />
        <Compile Include="Json/V4/V4JsonDecoding.fs" />
        <Compile Include="Json/V4/V4JsonValues.fs" />
        <Compile Include="Json/V4/V4JsonDistributions.fs" />
        <Compile Include="Json/V4/V4Json.fs" />
        <Compile Include="Json/V4/V4JsonWriter.fs" />
        <!-- The document-tree store maps trees to files with the v4 codecs, so it comes after them. -->
        <Compile Include="IR/Trees/TreeStoreTypes.fs" />
        <!-- Morphir files, plain or compacted with a name context; the store reads every tree file through them. -->
        <Compile Include="IR/Files/NameContext.fs" />
        <Compile Include="IR/Files/ContextExpansion.fs" />
        <Compile Include="IR/Files/MorphirFile.fs" />
        <Compile Include="IR/Trees/TreeFileCodec.fs" />
        <Compile Include="IR/Trees/V4TreeFiles.fs" />
        <Compile Include="IR/Trees/ClassicTreeFiles.fs" />
        <Compile Include="IR/Trees/TreeLayout.fs" />
        <Compile Include="IR/Trees/TreeFileSource.fs" />
        <Compile Include="IR/Trees/TreeReader.fs" />
        <Compile Include="IR/Trees/TreeWriter.fs" />
        <Compile Include="IR/Trees/V4TreeWriter.fs" />
        <Compile Include="IR/Trees/V4TreeReader.fs" />
        <Compile Include="IR/Trees/ClassicTreeWriter.fs" />
        <Compile Include="IR/Trees/ClassicTreeReader.fs" />
        <Compile Include="IR/Trees/DocumentTreeStore.fs" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Morphir.Models.Tests" />
        <InternalsVisibleTo Include="Morphir.CodeGeneration.FSharp" />
        <!-- The netstandard2.0 pipeline target of Morphir.Lang.CSharp uses the polyfill members of Morphir.Compat. -->
        <InternalsVisibleTo Include="Morphir.Lang.CSharp" />
    </ItemGroup>

</Project>

