<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Morphir</RootNamespace>
        <Description>Morphir IR model definitions in F#</Description>
        <PackageTags>$(PackageTags);morphir;fsharp;ir</PackageTags>
        <!-- Enable trimming analyzers for AOT/trimming compatibility -->
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="System.Text.Json" />
        <PackageReference Include="FSharp.SystemTextJson" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="IR/Name.fs" />
        <Compile Include="IR/Path.fs" />
        <Compile Include="IR/PackageName.fs" />
        <Compile Include="IR/ModulePath.fs" />
        <Compile Include="IR/FQName.fs" />
        <Compile Include="IR/QName.fs" />
        <Compile Include="IR/CanonicalNames.fs" />
        <Compile Include="IR/Versioning.fs" />
        <Compile Include="IR/Classic/AccessControlled.fs" />
        <Compile Include="IR/Classic/Type.fs" />
        <Compile Include="IR/Classic/Literal.fs" />
        <Compile Include="IR/Classic/Pattern.fs" />
        <Compile Include="IR/Classic/Value.fs" />
        <Compile Include="IR/Classic/Aliases.fs" />
        <Compile Include="IR/Classic/Documented.fs" />
        <Compile Include="IR/Classic/Module.fs" />
        <Compile Include="IR/Classic/Package.fs" />
        <Compile Include="IR/Classic/Distribution.fs" />
        <Compile Include="IR/Classic/DSL/Helpers.fs" />
        <Compile Include="IR/Classic/DSL/Types.fs" />
        <Compile Include="IR/Classic/DSL/Values.fs" />
        <Compile Include="IR/Classic/DSL/Patterns.fs" />
        <Compile Include="IR/Classic/DSL/Literals.fs" />
        <Compile Include="IR/Classic/DSL/Modules.fs" />
        <Compile Include="IR/Classic/DSL/Packages.fs" />
        <Compile Include="IR/Classic/DSL/Distributions.fs" />
        <Compile Include="IR/V4/OrderedMap.fs" />
        <Compile Include="IR/V4/Common.fs" />
        <Compile Include="IR/V4/Literal.fs" />
        <Compile Include="IR/V4/Type.fs" />
        <Compile Include="IR/V4/Value.fs" />
        <Compile Include="IR/V4/Module.fs" />
        <Compile Include="IR/V4/Distribution.fs" />
        <Compile Include="IR/DSL/Names.fs" />
        <Compile Include="IR/DSL/DSL.fs" />
        <Compile Include="Json/MorphirJsonOptions.fs" />
        <Compile Include="Json/Encode.fs" />
        <Compile Include="Json/Decode.fs" />
        <Compile Include="Json/Codecs/NameCodec.fs" />
        <Compile Include="Json/Codecs/PathCodec.fs" />
        <Compile Include="Json/Codecs/FQNameCodec.fs" />
        <Compile Include="Json/Codecs/LiteralCodec.fs" />
        <Compile Include="Json/Codecs/TypeCodec.fs" />
        <Compile Include="Json/Codecs/RawTypeCodec.fs" />
        <Compile Include="Json/Classic/ClassicJson.fs" />
        <Compile Include="Json/V4/V4JsonDecoding.fs" />
        <Compile Include="Json/V4/V4JsonValues.fs" />
        <Compile Include="Json/V4/V4JsonDistributions.fs" />
        <Compile Include="Json/V4/V4Json.fs" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Morphir.Models.Tests" />
        <InternalsVisibleTo Include="Morphir.CodeGeneration.FSharp" />
    </ItemGroup>

</Project>

