<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Morphir.Compilation.Mep</RootNamespace>
        <Description>The MEP 0.2.0-draft.1 host side of guest processes: the guest process and session, and the frontend adapter, an IFrontend over a guest that serves morphir.frontend.compileModel. Trim-safe and AOT-safe.</Description>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Morphir.Compilation\Morphir.Compilation.fsproj" />
        <ProjectReference Include="..\Morphir.Mep\Morphir.Mep.fsproj" />
        <ProjectReference Include="..\Morphir.Toolchain.IO\Morphir.Toolchain.IO.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="MepGuestProcess.fs" />
        <Compile Include="MepFrontend.fs" />
        <Compile Include="MepGenerationTransport.fs" />
    </ItemGroup>

</Project>
