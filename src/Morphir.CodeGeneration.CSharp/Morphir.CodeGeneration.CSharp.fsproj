<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(MorphirLibraryTargetFrameworks)</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Deterministic in-memory Morphir classic and v4 to C# generation</Description>
    <PackageReleaseNotes>### Added
Reusable typed C# generation with explicit language profiles and located diagnostics.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <ProjectReference Include="../Morphir.Models/Morphir.Models.fsproj" />
    <!-- The type catalog, the lowering and the checks moved to Morphir.Lang.CSharp (tasks.md, 4.6); this project keeps the text emission. -->
    <ProjectReference Include="../Morphir.Lang.CSharp/Morphir.Lang.CSharp.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ValueEmission.fs" />
    <Compile Include="Generator.fs" />
  </ItemGroup>
</Project>
