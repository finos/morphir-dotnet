<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Deterministic in-memory Morphir classic and v4 to C# generation</Description>
    <PackageReleaseNotes>### Added
Reusable typed C# generation with explicit language profiles and located diagnostics.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <ProjectReference Include="../Morphir.Models/Morphir.Models.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="TypeEmission.fs" />
    <Compile Include="Generator.fs" />
  </ItemGroup>
</Project>
