<Project>
    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>true</IsPackable>
        <PackageId>Morphir.SDK</PackageId>
        <Description>Compatibility package for the Morphir F# runtime. Depends on Morphir.SDK.FSharp, which retains the Morphir.SDK namespace and runtime assembly identity.</Description>
        <Authors>FINOS Morphir Team</Authors>
        <PackageTags>morphir;fsharp;sdk;compatibility</PackageTags>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
        <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Morphir.SDK.FSharp/Morphir.SDK.FSharp.fsproj" />
        <None Include="_._" Pack="true" PackagePath="lib/net10.0/" />
        <None Remove="$(MSBuildProjectDirectory)/../../README.md" />
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

    <!-- Pack metadata and build the dependency without compiling an empty runtime. -->
    <Target Name="Build" DependsOnTargets="SetVersionFromChangelog;ResolveProjectReferences" />
    <Target Name="Rebuild" DependsOnTargets="Clean;Build" />

    <Target Name="PinCanonicalRuntimeDependency" AfterTargets="_GetProjectReferenceVersions">
        <ItemGroup>
            <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)">
                <ProjectVersion>[$(PackageVersion), $(PackageVersion)]</ProjectVersion>
            </_ProjectReferencesWithVersions>
        </ItemGroup>
    </Target>
</Project>
