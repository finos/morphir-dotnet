<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Morphir classic IR to F# code generation</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Morphir.Models/Morphir.Models.fsproj" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fabulous.AST" />
    <PackageReference Include="Fantomas.Core" />
  </ItemGroup>
  <ItemGroup><Compile Include="Types.fs" /><Compile Include="Decode.fs" /><Compile Include="DependencyOrder.fs" /><Compile Include="Validate.fs" /><Compile Include="Emit.fs" /><Compile Include="Transpiler.fs" /></ItemGroup>
</Project>
