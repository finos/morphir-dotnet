<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(MorphirLibraryTargetFrameworks)</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- C# (Morphir.Tooling) calls this project, and the Native AOT morphir compiles it (rule 1 of the interop skill). -->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Every Fabulous.AST release asks for exactly Fantomas.Core 7.0.1; the repository pins a later patch centrally, as
         Morphir.Tooling and the guest do. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <Description>Morphir classic and v4 IR to F# code generation</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Morphir.Models/Morphir.Models.fsproj" />
    <ProjectReference Include="../Morphir.IR.Pipeline/Morphir.IR.Pipeline.fsproj" />
    <ProjectReference Include="../Morphir.IR.Pipeline.Plugins/Morphir.IR.Pipeline.Plugins.fsproj" />
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Fabulous.AST" PrivateAssets="compile" />
    <PackageReference Include="Fantomas.Core" PrivateAssets="compile" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Morphir.CodeGeneration.FSharp.Tests" /><InternalsVisibleTo Include="Morphir.Frontend.FSharp.Tests" /></ItemGroup>
  <ItemGroup><Compile Include="Types.fs" /><Compile Include="Decode.fs" /><Compile Include="DependencyOrder.fs" /><Compile Include="Validate.fs" /><Compile Include="TargetSyntax.fs" /><Compile Include="ScalarProfile.fs" /><Compile Include="Emit.fs" /><Compile Include="V4Support.fs" /><Compile Include="V4Check.fs" /><Compile Include="V4Expressions.fs" /><Compile Include="V4Optimizer.fs" /><Compile Include="V4Emit.fs" /><Compile Include="Transpiler.fs" /></ItemGroup>
</Project>
