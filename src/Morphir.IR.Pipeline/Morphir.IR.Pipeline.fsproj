<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(MorphirLibraryTargetFrameworks)</TargetFrameworks>
        <RootNamespace>Morphir.IR.Pipeline</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>File abstractions and the typed processor pipeline shared by morphir-dotnet frontends and backends: VFile, VFileTree and MorphirProcessor.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Property.fs" />
        <Compile Include="File.fs" />
        <Compile Include="FileTree.fs" />
        <Compile Include="Processor.fs" />
        <Compile Include="PipelineBuilder.fs" />
    </ItemGroup>

</Project>
