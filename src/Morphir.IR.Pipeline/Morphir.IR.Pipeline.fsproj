<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(MorphirLibraryTargetFrameworks)</TargetFrameworks>
        <RootNamespace>Morphir.IR.Pipeline</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>The typed processor pipeline shared by morphir-dotnet frontends and backends: MorphirProcessor, over the VFile and VFileTree of Morphir.Files.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Morphir.Files\Morphir.Files.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Processor.fs" />
        <Compile Include="PipelineBuilder.fs" />
    </ItemGroup>

</Project>
