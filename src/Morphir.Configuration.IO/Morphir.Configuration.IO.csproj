<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(MorphirLibraryTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Explicit-source Morphir configuration readers without CLI dependencies.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CsToml" />
    <PackageReference Include="YamlDotNet" />
    <ProjectReference Include="../Morphir.Configuration/Morphir.Configuration.fsproj" />
  </ItemGroup>
</Project>
