<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Morphir.Testing</RootNamespace>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" />
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Assertions.fs" />
        <Compile Include="GenerationCompiler.fs" />
        <Compile Include="GenerationConformance.fs" />
        <Compile Include="GenerationCases.fs" />
        <Compile Include="GenerationScalars.fs" />
        <Compile Include="GenerationArithmetic.fs" />
    </ItemGroup>

</Project>

