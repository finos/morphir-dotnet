<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(MorphirLibraryTargetFrameworks)</TargetFrameworks>
        <RootNamespace>Morphir.Ion</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>Reads Morphir's Amazon Ion formats: the Ion IR format and the MEP morphir_model document</Description>
        <PackageTags>$(PackageTags);morphir;ion;ir;mep</PackageTags>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Eleven19.IonDotnet" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Morphir.Models\Morphir.Models.fsproj" />
        <ProjectReference Include="..\Morphir.IR.Pipeline\Morphir.IR.Pipeline.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="IonValue.fs" />
        <Compile Include="IonReader.fs" />
        <Compile Include="IrDocument.fs" />
        <Compile Include="Ir/IonNodes.fs" />
        <Compile Include="Ir/IrHeader.fs" />
        <Compile Include="Ir/NormalizedDocument.fs" />
        <Compile Include="Ir/ClassicIonTypes.fs" />
        <Compile Include="Ir/ClassicIonValues.fs" />
        <Compile Include="Ir/ClassicIonDistribution.fs" />
        <Compile Include="Ir/V4IonTypes.fs" />
        <Compile Include="Ir/V4IonValues.fs" />
        <Compile Include="Ir/V4IonDistribution.fs" />
        <Compile Include="Ir/IonIr.fs" />
        <Compile Include="Ir/TreeStems.fs" />
        <Compile Include="Ir/IonSources.fs" />
        <Compile Include="Ir/IonIrTree.fs" />
        <Compile Include="Ir/IonIrParser.fs" />
        <Compile Include="IrProjection.fs" />
        <Compile Include="ModelDocument.fs" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Morphir.Ion.Tests" />
    </ItemGroup>

</Project>
