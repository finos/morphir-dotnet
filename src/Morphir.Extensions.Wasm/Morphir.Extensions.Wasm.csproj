<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Description>The WASM extension runtime of morphir-dotnet: Wasmtime with the embedded Extism kernel module.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Wasmtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Extism kernel module of moonrockz/extism; see Kernel/PROVENANCE.md. -->
    <EmbeddedResource Include="Kernel/extism-kernel.wasm" LogicalName="Morphir.Extensions.Wasm.Kernel.extism-kernel.wasm" />
    <None Include="Kernel/LICENSE;Kernel/NOTICE;Kernel/PROVENANCE.md" />
  </ItemGroup>
</Project>
