<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Morphir.Configuration</RootNamespace>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>Morphir configuration model: typed workspace and project configuration documents, layered resolution, profiles, validation and migration.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Types.fs" />
        <Compile Include="Merge.fs" />
        <Compile Include="CiDetection.fs" />
        <Compile Include="Documents.fs" />
        <Compile Include="Normalization.fs" />
        <Compile Include="Profiles.fs" />
        <Compile Include="EnvironmentMapping.fs" />
        <Compile Include="Schema.fs" />
        <Compile Include="Validation.fs" />
        <Compile Include="Resolver.fs" />
        <Compile Include="ProjectTypes.fs" />
        <Compile Include="ProjectDiscovery.fs" />
        <Compile Include="ProjectSources.fs" />
        <Compile Include="Inspection.fs" />
        <Compile Include="Editing.fs" />
        <Compile Include="Migration.fs" />
    </ItemGroup>

</Project>
