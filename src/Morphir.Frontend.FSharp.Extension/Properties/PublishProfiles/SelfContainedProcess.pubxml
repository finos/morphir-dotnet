<?xml version="1.0" encoding="utf-8"?>
<!--
  The self-contained process delivery of morphir-fsharp-frontend: a folder with the guest, the compiler service and
  its own .NET runtime, for hosts such as the AOT morphir executable on a machine without .NET. Give the runtime
  identifier on the command line:

    dotnet publish src/Morphir.Frontend.FSharp.Extension -c Release -r <rid> -p:PublishProfile=SelfContainedProcess -o <dir>

  The build target PublishFSharpFrontendProcess runs this and archives the folder.
  A folder, not a single file: the compiler references are files of the folder (CompilerEdge.selectReferences).
  Not trimmed and not Native AOT: FSharp.Compiler.Service is neither trim-safe nor AOT-safe.
-->
<Project>
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- The shipped folder has no symbols or XML documentation. -->
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <!-- No .pdb or .xml beside the referenced projects' assemblies. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
