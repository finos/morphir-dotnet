<!--
  An application publish passes PublishAot, PublishTrimmed and PublishSingleFile as global properties, which also reach
  this netstandard2.0 library through Morphir.Mep (for example dotnet publish src/Morphir -p:PublishAot=true). The SDK
  refuses them for netstandard2.0 (NETSDK1207), so this library keeps them local and off. The application still
  compiles and trims this assembly.
-->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed;PublishSingleFile">
  <PropertyGroup>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- netstandard2.0 and no package dependency, so any F# domain project can reference it. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Morphir.Myriad.SystemTextJson</RootNamespace>
    <Description>Attributes and options for Morphir.Myriad.SystemTextJson, which generates trim-safe System.Text.Json converters and contexts for F# types at build time.</Description>
    <PackageTags>fsharp;myriad;system.text.json;json;aot;trimming;source-generator</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../README.md'))" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
