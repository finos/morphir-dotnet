<?xml version="1.0" encoding="utf-8"?>
<!--
  The self-contained process delivery of morphir-fsharp-backend includes the generator, Fantomas, Fabulous.AST and
  its own .NET runtime. PublishFSharpBackendProcess supplies the RID, redirects RID locks under obj/publish-lock/
  with MorphirRidSpecificPublish=true, and archives the complete folder using ReleaseArchive.
  Trimming, single-file publication and Native AOT are not qualified for these generator dependencies.
-->
<Project>
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
