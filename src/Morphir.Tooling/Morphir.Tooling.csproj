<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <RootNamespace>Morphir.Tooling</RootNamespace>
    <!-- Make executable for codegen command when EnableCodegen property is set -->
    <OutputType Condition="'$(EnableCodegen)' == 'true'">Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Foundatio.Mediator for messaging (source-generated, trimming-friendly) -->
    <PackageReference Include="Foundatio.Mediator" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <!-- Command-line parsing -->
    <PackageReference Include="System.CommandLine" />

    <!-- JSON Schema validation -->
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Json.More.Net" />

    <!-- Validation -->
    <PackageReference Include="FluentValidation" />

    <!-- Logging -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed JSON schema files as resources -->
    <EmbeddedResource Include="Infrastructure\Schemas\*.json" />

    <!-- Preserve embedded resources during trimming -->
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to Morphir.Core for IR types (optional, for future extensibility) -->
    <ProjectReference Include="..\Morphir.Core\Morphir.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" PrivateAssets="all" />
  </ItemGroup>


</Project>

