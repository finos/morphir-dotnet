<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1608</NoWarn>
    <!-- Suppress trimming warnings for ConfigureWolverineCodeGeneration - only used in Release builds with pre-generated code -->
    <!-- Note: IL2026 suppression via UnconditionalSuppressMessage may not work for trimming analyzer -->
    <!-- The reflection is safe because it only runs when pre-generated code exists -->
    <WarningsAsErrors Condition="'$(EnableWolverineCodeGeneration)' == 'true'">$(WarningsAsErrors);-IL2026</WarningsAsErrors>
    <RootNamespace>Morphir.Tooling</RootNamespace>
    <!-- Make executable for codegen command when EnableCodegen property is set -->
    <OutputType Condition="'$(EnableCodegen)' == 'true'">Exe</OutputType>
    <!-- EnableWolverineCodeGeneration: Controls whether to generate Wolverine code at build time
         Defaults to true for Release builds, false for Debug builds
         Can be overridden: dotnet build -p:EnableWolverineCodeGeneration=true -->
    <EnableWolverineCodeGeneration Condition="'$(EnableWolverineCodeGeneration)' == '' And '$(Configuration)' == 'Release'">true</EnableWolverineCodeGeneration>
    <EnableWolverineCodeGeneration Condition="'$(EnableWolverineCodeGeneration)' == '' And '$(Configuration)' != 'Release'">false</EnableWolverineCodeGeneration>
    <!-- Define compile-time constant for conditional code generation configuration -->
    <DefineConstants Condition="'$(EnableWolverineCodeGeneration)' == 'true'">$(DefineConstants);ENABLE_WOLVERINE_CODE_GENERATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- WolverineFx for messaging -->
    <PackageReference Include="JasperFx.CodeGeneration.Commands" />
    <PackageReference Include="WolverineFx" />
    <!-- Explicit reference to force Microsoft.Extensions.Hosting 10.0.0 for WolverineFx 5.8.0 -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <!-- JSON Schema validation -->
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Json.More.Net" />

    <!-- Validation -->
    <PackageReference Include="FluentValidation" />

    <!-- Logging -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed JSON schema files as resources -->
    <EmbeddedResource Include="Infrastructure\Schemas\*.json" />

    <!-- Preserve embedded resources during trimming -->
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to Morphir.Core for IR types (optional, for future extensibility) -->
    <ProjectReference Include="..\Morphir.Core\Morphir.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wolverine pre-generated code is automatically included by the SDK -->
    <!-- Files in Internal/Generated/ will be compiled automatically -->
    <!-- Generated code is created by the GenerateWolverineCode target in Directory.Build.targets -->
  </ItemGroup>

</Project>

