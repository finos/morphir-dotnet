<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(MorphirLibraryTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <Description>Local extension package installation, inventory, selection and activation for Morphir tooling.</Description>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Semver" />
    <PackageReference Include="NuGet.Versioning" />
    <PackageReference Include="NuGet.Packaging" />
    <PackageReference Include="NuGet.Configuration" />
    <PackageReference Include="NuGet.Protocol" />
    <PackageReference Include="NuGet.Credentials" />
    <!-- The security pin of Directory.Packages.props: NuGet.Packaging asks for an older Pkcs with known CVEs. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <ProjectReference Include="../Morphir.Extensions/Morphir.Extensions.fsproj" />
    <ProjectReference Include="../Morphir.Mep/Morphir.Mep.fsproj" />
    <ProjectReference Include="../Morphir.Toolchain/Morphir.Toolchain.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Identifiers.fs" />
    <Compile Include="Platforms.fs" />
    <Compile Include="MepSupport.fs" />
    <Compile Include="SharedJson.fs" />
    <Compile Include="Sources.fs" />
    <Compile Include="Claims.fs" />
    <Compile Include="Descriptors.fs" />
    <Compile Include="FileSafety.fs" />
    <Compile Include="PrivateStaging.fs" />
    <Compile Include="Store.fs" />
    <Compile Include="Archives.fs" />
    <Compile Include="RunCopies.fs" />
    <Compile Include="StateDocuments.fs" />
    <Compile Include="InstalledState.fs" />
    <Compile Include="Packages.fs" />
    <Compile Include="ActivationRecords.fs" />
    <Compile Include="Providers.fs" />
    <Compile Include="NuGetProvider.fs" />
    <Compile Include="ExtensionSources.fs" />
  </ItemGroup>
</Project>
