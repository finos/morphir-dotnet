<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
          netstandard2.0 holds the core that the pipeline function of Morphir.Lang.CSharp needs in a compiler host: checked
          results, diagnostics and the exact IR targets. The rest (builders, writers, registries and frontends) uses
          System.Text.Rune and other types that netstandard2.0 does not have.
        -->
        <TargetFrameworks>$(MorphirLibraryTargetFrameworks);netstandard2.0</TargetFrameworks>
        <RootNamespace>Morphir.Compilation</RootNamespace>
        <Description>Language-neutral Morphir compilation contracts: exact IR targets, checked diagnostics, the IR builder interface and the writer, builder and project-file provider registries.</Description>
        <PackageReleaseNotes>### Added
Exact IR targets, checked diagnostics, the IR builder interface and compilation registries.</PackageReleaseNotes>
        <PackageTags>$(PackageTags);morphir;fsharp;compiler</PackageTags>
        <!-- C# callers read the nullable metadata that F# nullness writes. Without it, C# sees F# types as oblivious. -->
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Trimming and AOT analyzers for the frameworks that support them (NETSDK1210, NETSDK1212). -->
    <PropertyGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Morphir.Models\Morphir.Models.fsproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Text.Json" />
        <Compile Include="Polyfill.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Diagnostics.fs" />
        <Compile Include="Checked.fs" />
        <Compile Include="Versions.fs" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
        <Compile Include="Builders.fs" />
        <Compile Include="Registries.fs" />
        <Compile Include="Writers.fs" />
        <Compile Include="FamilyBuilders.fs" />
        <Compile Include="Frontends.fs" />
        <Compile Include="TextParsing.fs" />
    </ItemGroup>

</Project>
