<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Generate F# modules from classic Morphir model JSON through Myriad.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Tool assemblies intentionally are not consumer references. -->
    <NoWarn>$(NoWarn);NU5100</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Myriad.Core" />
    <ProjectReference Include="../Morphir.CodeGeneration.FSharp/Morphir.CodeGeneration.FSharp.fsproj" />
    <ProjectReference Include="../Morphir.Myriad.Build/Morphir.Myriad.Build.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="MorphirFSharpGenerator.fs" />
    <None Remove="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../README.md'))" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="ThirdPartyNotices.txt" Pack="true" PackagePath="/" />
    <None Include="build/Morphir.Myriad.props" Pack="true" PackagePath="build/" />
    <None Include="build/Morphir.Myriad.targets" Pack="true" PackagePath="build/" />
  </ItemGroup>
  <PropertyGroup>
    <MyriadTaskProjectDirectory>$(MSBuildThisFileDirectory)../Morphir.Myriad.Build</MyriadTaskProjectDirectory>
  </PropertyGroup>
  <Import Project="../Morphir.Myriad.Hosting/build/MyriadHostPackaging.targets" />
</Project>
