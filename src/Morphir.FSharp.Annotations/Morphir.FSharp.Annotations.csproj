<!--
  An application publish passes PublishAot, PublishTrimmed and PublishSingleFile as global properties, which also reach
  this netstandard2.0 library (for example dotnet publish src/Morphir -p:PublishAot=true). The SDK refuses them for
  netstandard2.0 (NETSDK1207), so this library keeps them local and off.
-->
<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;PublishTrimmed;PublishSingleFile">

    <PropertyGroup>
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
    </PropertyGroup>

    <PropertyGroup>
        <!-- netstandard2.0 with no dependency, so any F# project can reference it with any FSharp.Core. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RootNamespace>Morphir</RootNamespace>
        <IsPackable>true</IsPackable>
        <PackageId>Morphir.FSharp.Annotations</PackageId>
        <Description>Attributes that F# source code uses to give Morphir information to the Morphir F# frontend, such as [&lt;MorphirName&gt;]. No dependencies.</Description>
        <PackageReleaseNotes>### Added
MorphirNameAttribute: sets the Morphir name of a declaration.</PackageReleaseNotes>
        <PackageTags>$(PackageTags);morphir;fsharp;attributes</PackageTags>
    </PropertyGroup>

</Project>
