<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Morphir.Live</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Disable debug symbols for cleaner WASM experience -->
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Order matters in F# - compile in dependency order -->
    <Compile Include="Components/Layout.fs" />
    <Compile Include="Pages/Index.fs" />
    <Compile Include="Pages/Counter.fs" />
    <Compile Include="Pages/NotFound.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fun.Blazor packages -->
    <PackageReference Include="Fun.Blazor" />
    <PackageReference Include="Fun.Blazor.MudBlazor" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="FSharp.Core" />

    <!-- Blazor WASM support -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

</Project>
