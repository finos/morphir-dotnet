<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>$(MorphirLibraryTargetFrameworks)</TargetFrameworks>
        <RootNamespace>Morphir.Analyzers</RootNamespace>
        <Description>Built-in Morphir model analyzers, such as the type validator, and their extension entries</Description>
        <PackageReleaseNotes>### Added
The built-in analyzer morphir.type-validator and the list of built-in analyzers.</PackageReleaseNotes>
        <PackageTags>$(PackageTags);morphir;fsharp;analyzers</PackageTags>
        <!-- C# callers read the nullable metadata that F# nullness writes. Without it, C# sees F# types as oblivious. -->
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <IsAotCompatible>true</IsAotCompatible>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Morphir.Extensions\Morphir.Extensions.fsproj" />
        <ProjectReference Include="..\Morphir.IR.Pipeline.Plugins\Morphir.IR.Pipeline.Plugins.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="MessageMapping.fs" />
        <Compile Include="TypeValidatorAnalyzer.fs" />
        <Compile Include="BuiltInAnalyzers.fs" />
    </ItemGroup>

</Project>
