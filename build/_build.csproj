<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS0649;CS0169</NoWarn>
    <RootNamespace></RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ionide.KeepAChangelog" />
    <PackageReference Include="Fallout.Common" />
    <ProjectReference Include="../src/Morphir.Extensions.Installation/Morphir.Extensions.Installation.fsproj" />
    <ProjectReference Include="../src/Morphir.Compilation.Mep/Morphir.Compilation.Mep.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PowerShell module of the Pester tests of the scripts (the TestScripts target). It is not a dotnet tool, so
         the restore of this project downloads it into the NuGet packages folder, pinned, and the target imports it. -->
    <PackageDownload Include="Pester" Version="[6.2.0]" />
  </ItemGroup>

</Project>
