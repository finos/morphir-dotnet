<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <!-- Same FSharp.Core summary baseline as the generated-code probe; the Nuke target rejects all other IL diagnostics. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot Condition="'$(MorphirProbeAot)' == 'true'">true</PublishAot>
    <StripSymbols Condition="'$(MorphirProbeAot)' == 'true'">true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Morphir.Mep/Morphir.Mep.fsproj" />
  </ItemGroup>
</Project>
