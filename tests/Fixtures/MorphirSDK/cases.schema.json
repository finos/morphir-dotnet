{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:morphir:dotnet-sdk:cases:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractId": {
      "const": "morphir-dotnet-sdk-v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "typeArguments": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "arguments": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/value"
            }
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "$ref": "#/$defs/value"
                  }
                },
                "required": [
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "error": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "code",
                      "detail"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "error"
                ],
                "additionalProperties": false
              }
            ]
          },
          "profile": {
            "const": "dotnet-sdk-v1"
          },
          "classification": {
            "enum": [
              "required",
              "representation-excluded"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "basis": {
            "enum": [
              "source-derived",
              "dotnet-extension"
            ]
          },
          "knownGaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "invariants": {
            "type": "object",
            "properties": {
              "preserveArguments": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "uniqueItems": true
              },
              "equalTo": {
                "$ref": "#/$defs/value"
              },
              "hashEqualTo": {
                "$ref": "#/$defs/value"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "exclusion": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "code",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "caseId",
          "operation",
          "typeArguments",
          "arguments",
          "expected",
          "profile",
          "classification",
          "evidence",
          "basis",
          "knownGaps",
          "invariants"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "representation-excluded"
                }
              }
            },
            "then": {
              "required": [
                "exclusion"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "exclusion"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "contractId",
    "cases"
  ],
  "additionalProperties": false,
  "$defs": {
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "int"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            }
          },
          "required": [
            "tag",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "float"
            },
            "value": {
              "type": "string",
              "pattern": "^(NaN|[+-]Infinity|[+-]0|-?(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]+)(?:[eE][+-]?[0-9]+)?)$"
            }
          },
          "required": [
            "tag",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "decimal"
            },
            "coefficient": {
              "type": "string",
              "pattern": "^(0|-?[1-9][0-9]*)$"
            },
            "scale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4096
            }
          },
          "required": [
            "tag",
            "coefficient",
            "scale"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "tag",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "char"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1
            }
          },
          "required": [
            "tag",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "tag",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "order"
            },
            "value": {
              "enum": [
                "LT",
                "EQ",
                "GT"
              ]
            }
          },
          "required": [
            "tag",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "unit"
            }
          },
          "required": [
            "tag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "nothing"
            }
          },
          "required": [
            "tag"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "just"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "tag",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "ok"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "tag",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "err"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "required": [
            "tag",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "tag",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "tuple"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              },
              "minItems": 2,
              "maxItems": 3
            }
          },
          "required": [
            "tag",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "set"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          },
          "required": [
            "tag",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "dict"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/value"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "tag",
            "entries"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "const": "callback"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "tag",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
