  "representationExclusions": [
    {
      "caseId": "Basics.power/int-negative-exponent",
      "code": "IntegerNegativeExponent",
      "reason": "Reference returns Float 0.5, outside Int -> Int closure."
    },
    {
      "caseId": "Basics.toFloat/outside-int",
      "code": "IntegerOutOfRange",
      "reason": "Input exceeds signed Int32."
    },
    {
      "caseId": "Basics.compare/nonfinite-key",
      "code": "NonFiniteComparable",
      "reason": "NaN is not a total ordered key. Python's fallback comparison reports EQ; that is not admitted parity."
    },
    {
      "caseId": "Basics.compare/supplementary-char",
      "code": "CharOutOfRange",
      "reason": "One Unicode scalar exceeds one non-surrogate UTF-16 Char."
    },
    {
      "caseId": "Decimal.add/scale-29",
      "code": "DecimalScaleOutOfRange",
      "reason": "Nonzero digit at scale 29 cannot be represented exactly in Decimal96."
    },
    {
      "caseId": "Decimal.add/coefficient-97-bits",
      "code": "DecimalCoefficientOutOfRange",
      "reason": "Input coefficient exceeds 96 bits."
    },
    {
      "caseId": "Decimal.mul/result-scale",
      "code": "DecimalScaleOutOfRange",
      "reason": "Exact result needs scale 29. .NET rounding to zero is not admitted."
    },
    {
      "caseId": "Decimal.div/nonterminating",
      "code": "DecimalNonTerminating",
      "reason": "Python's 50-digit rounded observation retained; MoonBit truncates at exponent -32. Neither is exact Decimal96 parity."
    }
  ],
