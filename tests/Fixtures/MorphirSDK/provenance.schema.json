{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:morphir:dotnet-sdk:provenance:v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "upstreamPath": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "license": {
            "const": "Apache-2.0"
          },
          "licenseSource": {
            "type": "string",
            "minLength": 1
          },
          "noticeSource": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "repository",
          "revision",
          "path",
          "upstreamPath",
          "url",
          "sha256",
          "license",
          "licenseSource",
          "noticeSource"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "sources"
  ],
  "additionalProperties": false
}
