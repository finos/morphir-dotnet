{
 "formatVersion": 4,
 "distribution": {
  "Application": {
   "packageName": "example",
   "dependencies": {
    "my-org/shared": {
     "modules": {
      "util": {
       "Public": {
        "types": {},
        "values": {
         "identity": {
          "Public": {
           "ExpressionBody": {
            "inputTypes": {
             "x": "morphir/SDK:basics#int"
            },
            "outputType": "morphir/SDK:basics#int",
            "body": {
             "Variable": "x"
            }
           }
          }
         }
        }
       }
      },
      "secret": {
       "Private": {
        "doc": "Hidden.",
        "types": {},
        "values": {}
       }
      }
     }
    },
    "empty": {
     "modules": {}
    }
   },
   "def": {
    "modules": {
     "main": {
      "Public": {
       "types": {},
       "values": {
        "run": {
         "Public": {
          "ExpressionBody": {
           "inputTypes": {},
           "outputType": "morphir/SDK:basics#unit",
           "body": {
            "Unit": {}
           }
          }
         }
        }
       }
      }
     }
    }
   },
   "entryPoints": {
    "start": {
     "target": "example:main#run",
     "kind": "main",
     "doc": "The application entry point"
    },
    "build": {
     "target": "example:main#run",
     "kind": "command"
    },
    "on event": {
     "target": "example:main#run",
     "kind": "handler"
    },
    "nightly": {
     "target": "example:main#run",
     "kind": "job"
    },
    "guard": {
     "target": "example:main#run",
     "kind": "policy"
    }
   }
  }
 }
}
