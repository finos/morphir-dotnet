<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for the parent's morphir-mck, for the tests of morphir mck routing. It reports what it received and can
    exit with a given code or start a grandchild. It is not a compatibility kit.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <AssemblyName>morphir-mck</AssemblyName>
    <RootNamespace>Morphir.Mck.Stub</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
