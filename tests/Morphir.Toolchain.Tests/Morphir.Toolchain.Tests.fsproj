<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="FSharp.Core" />
    <!-- Test only: the pinned JSON Schemas check the readers' claims and every writer's output. -->
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Morphir.Toolchain/Morphir.Toolchain.fsproj" />
    <ProjectReference Include="../../src/Morphir.Toolchain.IO/Morphir.Toolchain.IO.fsproj" />
    <ProjectReference Include="../../src/Morphirup/Morphirup.fsproj" />
    <ProjectReference Include="../../src/Morphir.Configuration.IO/Morphir.Configuration.IO.csproj" />
    <ProjectReference Include="../Morphir.TestSupport/Morphir.TestSupport.csproj" />
    <ProjectReference Include="../Morphir.Toolchain.ProcessFixture/Morphir.Toolchain.ProcessFixture.fsproj" ReferenceOutputAssembly="false" />
    <Compile Include="Fixtures.fs" />
    <Compile Include="ProvenanceTests.fs" />
    <Compile Include="Manifest.fs" />
    <Compile Include="DocumentCaseTests.fs" />
    <Compile Include="PreviewDocumentCaseTests.fs" />
    <Compile Include="BindingCaseTests.fs" />
    <Compile Include="TufFixture.fs" />
    <Compile Include="TufTests.fs" />
    <Compile Include="TufCheckpointTests.fs" />
    <Compile Include="ContractTableTests.fs" />
    <Compile Include="NormalizationTests.fs" />
    <Compile Include="CanonicalJsonTests.fs" />
    <Compile Include="Sha256Tests.fs" />
    <Compile Include="PrimitiveTests.fs" />
    <Compile Include="PlanningTests.fs" />
    <Compile Include="WriterTests.fs" />
    <Compile Include="CliTests.fs" />
    <Compile Include="LocalCandidateTests.fs" />
    <Compile Include="ReleaseSetupTests.fs" />
    <Compile Include="MacArm64SetupTests.fs" />
    <Compile Include="LocalProcessOwnershipTests.fs" />
    <Compile Include="DryRunTests.fs" />
    <Compile Include="ConfigurationAdapterTests.fs" />
    <Compile Include="SchemaTests.fs" />
    <Compile Include="RefusalResultTests.fs" />
    <Compile Include="ReleaseSchemaTests.fs" />
    <Compile Include="SignedCaseTests.fs" />
    <Compile Include="ReleaseDescriptorTests.fs" />
    <Compile Include="BindingReviewTests.fs" />
    <Compile Include="HardeningTests.fs" />
    <Compile Include="MutationTests.fs" />
    <Compile Include="RequiredMemberTests.fs" />
    <Compile Include="WorkflowCaseTests.fs" />
    <Compile Include="CorpusGateTests.fs" />
    <Compile Include="FixtureGenerator.fs" />
    <Compile Include="FixtureGenerationTests.fs" />
    <Compile Include="CorpusModeTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <!-- GetTargetPath uses the same active configuration/global output properties as
       the project reference. Copy its runtime closure, including satellites,
       never a hardcoded Release tree or a recursive copy of our own output. -->
  <Target Name="CopyCurrentProcessFixture" AfterTargets="Build">
    <MSBuild Projects="../Morphir.Toolchain.ProcessFixture/Morphir.Toolchain.ProcessFixture.fsproj"
             Targets="GetTargetPath" BuildInParallel="false"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_CurrentProcessFixture" />
    </MSBuild>
    <PropertyGroup>
      <_CurrentProcessFixtureDirectory>@(_CurrentProcessFixture->'%(RootDir)%(Directory)')</_CurrentProcessFixtureDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_CurrentProcessFixtureRuntime Include="$(_CurrentProcessFixtureDirectory)**/*.dll;$(_CurrentProcessFixtureDirectory)*.json"
                                    Exclude="$(_CurrentProcessFixtureDirectory)ProcessFixture/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_CurrentProcessFixtureRuntime)"
          DestinationFiles="@(_CurrentProcessFixtureRuntime->'$(OutDir)ProcessFixture/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
