<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <GenerateProgramFile>false</GenerateProgramFile>
        <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <RootNamespace>Morphir</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Expecto" />
        <PackageReference Include="Expecto.FsCheck" />
        <PackageReference Include="Verify.Expecto" />
        <!-- The embedded provider of "The same tree from two sources" in IR/Trees/V4StoreTests.fs. -->
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    </ItemGroup>

    <!--
      The tree of "The same tree from two sources", which FixtureCatalog.Trees owns, embedded with a manifest below
      AcmeDemoTree/, so ManifestEmbeddedFileProvider gives its files at their locations in the tree.
    -->
    <PropertyGroup>
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
        <!-- The manifest splits a link at the platform's separator, which %(RecursiveDir) also uses. -->
        <AcmeDemoTreeLink>AcmeDemoTree$([System.IO.Path]::DirectorySeparatorChar)</AcmeDemoTreeLink>
    </PropertyGroup>
    <ItemGroup>
        <EmbeddedResource Include="../Fixtures/MorphirTrees/acme-demo/**/*.json" Link="$(AcmeDemoTreeLink)%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Morphir.Models\Morphir.Models.fsproj" />
        <ProjectReference Include="..\..\src\Morphir.Testing\Morphir.Testing.fsproj" />
        <ProjectReference Include="..\Morphir.Models.TestSupport\Morphir.Models.TestSupport.fsproj" />
        <!-- FixtureCatalog: the pinned kit tree cases that the store tests read. -->
        <ProjectReference Include="..\Morphir.TestSupport\Morphir.TestSupport.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="IR/NameTests.fs" />
        <Compile Include="IR/PathTests.fs" />
        <Compile Include="IR/PackageNameTests.fs" />
        <Compile Include="IR/ModulePathTests.fs" />
        <Compile Include="IR/FQNameTests.fs" />
        <Compile Include="IR/CanonicalNamesTests.fs" />
        <Compile Include="IR/VersionedModelTests.fs" />
        <Compile Include="IR/Trees/TreeStemsTests.fs" />
        <Compile Include="IR/Trees/DocumentAddressTests.fs" />
        <Compile Include="IR/Trees/V4DocumentTreeTests.fs" />
        <Compile Include="IR/Trees/ClassicDocumentTreeTests.fs" />
        <Compile Include="IR/Trees/StoreTestKit.fs" />
        <Compile Include="IR/Trees/V4StoreTests.fs" />
        <Compile Include="IR/Trees/ClassicStoreTests.fs" />
        <Compile Include="IR/Trees/RefusalTests.fs" />
        <Compile Include="IR/Trees/ArchitectureTests.fs" />
        <Compile Include="IR/Classic/AccessControlledTests.fs" />
        <Compile Include="IR/Classic/TypeTests.fs" />
        <Compile Include="IR/Classic/LiteralTests.fs" />
        <Compile Include="IR/Classic/PatternTests.fs" />
        <Compile Include="IR/Classic/ValueTests.fs" />
        <Compile Include="IR/Classic/DocumentedTests.fs" />
        <Compile Include="IR/Classic/ModuleTests.fs" />
        <Compile Include="IR/Classic/PackageTests.fs" />
        <Compile Include="IR/Classic/DistributionTests.fs" />
        <Compile Include="IR/V4/ModelTests.fs" />
        <Compile Include="IR/DSL/NamesTests.fs" />
        <Compile Include="IR/DSL/TypesTests.fs" />
        <Compile Include="IR/DSL/ValuesTests.fs" />
        <Compile Include="IR/DSL/PatternsTests.fs" />
        <Compile Include="IR/DSL/LiteralsTests.fs" />
        <Compile Include="IR/DSL/ModulesTests.fs" />
        <Compile Include="IR/DSL/PackagesTests.fs" />
        <Compile Include="IR/DSL/DistributionsTests.fs" />
        <Compile Include="IR/DSL/IntegrationTests.fs" />
        <Compile Include="Json/CodecTests.fs" />
        <Compile Include="Json/ClassicJsonTests.fs" />
        <Compile Include="Json/ClassicJsonWriterTests.fs" />
        <Compile Include="Json/UpstreamIrTests.fs" />
        <Compile Include="Json/V4/KitCases.fs" />
        <Compile Include="Json/V4/V4KitTests.fs" />
        <Compile Include="Json/V4/V4JsonTests.fs" />
        <Compile Include="Json/V4/V4JsonWriterTests.fs" />
        <Compile Include="TestSupport/MotherTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

</Project>

