<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Morphir.E2E.Tests</RootNamespace>
    <EnableMicrosoftTestingExtensions>true</EnableMicrosoftTestingExtensions>
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing frameworks -->
    <PackageReference Include="TUnit" />
    <PackageReference Include="coverlet.collector" />

    <!-- BDD framework -->
    <PackageReference Include="Reqnroll" />
    <PackageReference Include="Reqnroll.TUnit" />

    <!-- Assertions -->
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gherkin feature files -->
    <Content Include="**/*.feature"/>
    <!-- The worker's crafted guests (add-wasm-extension-host, task 4.1): WebAssembly text and its conversion. -->
    <None Update="TestData/Wasm/*" CopyToOutputDirectory="IfDifferent" />
    <!-- Host trace fixtures of the infrastructure tests -->
    <None Include="InfrastructureTests/Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Reqnroll" />
  </ItemGroup>

  <ItemGroup>
    <!-- hiding .gitkeep files in Visual Studio; they are only needed to ensure the existence of the empty folders in git -->
    <None Update="**/.gitkeep" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Morphir.TestSupport/Morphir.TestSupport.csproj" />
    <!-- The generic guest kit's model-tier runner and its worker session factory (add-wasm-extension-host, task 4.3). -->
    <ProjectReference Include="../../src/Morphir.Conformance/Morphir.Conformance.fsproj" />
  </ItemGroup>

</Project>

