<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableMicrosoftTestingExtensions>true</EnableMicrosoftTestingExtensions>
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="Reqnroll" />
    <PackageReference Include="Reqnroll.TUnit" />
    <PackageReference Include="coverlet.collector" />
    <Content Include="**/*.feature" />
    <EmbeddedResource Include="../Fixtures/MorphirIR/*" LogicalName="Morphir.Tests.Fixtures.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../examples/car-rental/models/*.json" LogicalName="Morphir.Tests.Fixtures.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Morphir.TestSupport/Morphir.TestSupport.csproj" />
  </ItemGroup>

</Project>
