<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Morphir.SDK.Tests</RootNamespace>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <GenerateProgramFile>false</GenerateProgramFile>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" />
        <PackageReference Include="Expecto.FsCheck" />
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" />
        <PackageReference Include="coverlet.collector">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="altcover" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Morphir.SDK\Morphir.SDK.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="BasicsTests.fs" />
        <Compile Include="MaybeTests.fs" />
        <Compile Include="ResultTests.fs" />
        <Compile Include="ListTests.fs" />
        <Compile Include="StringTests.fs" />
        <Compile Include="IntTests.fs" />
        <Compile Include="BoolTests.fs" />
        <Compile Include="CharTests.fs" />
        <Compile Include="DictTests.fs" />
        <Compile Include="SetTests.fs" />
        <Compile Include="TupleTests.fs" />
        <Compile Include="LocalDateTests.fs" />
        <Compile Include="LocalTimeTests.fs" />
        <Compile Include="DecimalTests.fs" />
        <Compile Include="PropertyTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

</Project>
