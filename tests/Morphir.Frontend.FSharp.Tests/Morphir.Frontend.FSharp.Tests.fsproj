<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Morphir.Conformance/Morphir.Conformance.fsproj" />
    <ProjectReference Include="../../src/Morphir.Frontend.FSharp/Morphir.Frontend.FSharp.fsproj" />
    <!-- The SDK mapping tests check that the F# generator writes every entry back. -->
    <ProjectReference Include="../../src/Morphir.CodeGeneration.FSharp/Morphir.CodeGeneration.FSharp.fsproj" />
    <ProjectReference Include="../Morphir.TestSupport/Morphir.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="FixtureProvenanceTests.fs" />
    <Compile Include="ConformanceTests.fs" />
    <Compile Include="AnalysisSupport.fs" />
    <Compile Include="CompilerEdgeTests.fs" />
    <Compile Include="EvidenceTests.fs" />
    <Compile Include="AdmissionTests.fs" />
    <Compile Include="PlanningTests.fs" />
    <Compile Include="LoweringSupport.fs" />
    <Compile Include="TypeLoweringTests.fs" />
    <Compile Include="ValueLoweringTests.fs" />
    <Compile Include="SdkMappingTests.fs" />
    <Compile Include="RegistrationTests.fs" />
    <Compile Include="GeneratedCalls.fs" />
    <Compile Include="CorpusTests.fs" />
    <Compile Include="RoundTripTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
