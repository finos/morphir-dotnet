<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
        <RootNamespace>Morphir.Files.Tests</RootNamespace>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <GenerateProgramFile>false</GenerateProgramFile>
        <IsPackable>false</IsPackable>
        <!-- NetStandardHost is a project of its own that NetStandardTests.fs builds. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);NetStandardHost/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" />
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" />
        <PackageReference Include="coverlet.collector">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="altcover" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Morphir.Files\Morphir.Files.fsproj" />
        <ProjectReference Include="..\Morphir.TestSupport\Morphir.TestSupport.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="PropertyBagTests.fs" />
        <Compile Include="FileTests.fs" />
        <Compile Include="ContentTests.fs" />
        <Compile Include="FileTreeTests.fs" />
        <Compile Include="PublicationTests.fs" />
        <Compile Include="NetStandardTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

</Project>
