<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Foundatio.Mediator.Generated</InterceptorsNamespaces>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Morphir.Tooling.Tests</RootNamespace>
    <EnableMicrosoftTestingExtensions>true</EnableMicrosoftTestingExtensions>
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing frameworks -->
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="coverlet.collector" />
    <!-- Explicit reference to force Microsoft.Extensions.Hosting 10.0.0 for WolverineFx 5.8.0 -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <!-- Assertions and verification -->
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Verify.TUnit" />

    <!-- BDD framework -->
    <PackageReference Include="Reqnroll" />
    <PackageReference Include="Reqnroll.TUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project under test -->
    <ProjectReference Include="..\..\src\Morphir.Tooling\Morphir.Tooling.csproj" />
    <ProjectReference Include="..\..\src\Morphir.Testing\Morphir.Testing.fsproj" />
    <ProjectReference Include="..\Morphir.TestSupport\Morphir.TestSupport.csproj" />
    <!-- The in-process F# frontend and the MCK corpus, for the compile fold property and the tool path (task 4.6). -->
    <ProjectReference Include="..\..\src\Morphir.Frontend.FSharp\Morphir.Frontend.FSharp.fsproj" />
    <ProjectReference Include="..\..\src\Morphir.Frontend.FSharp.Extension\Morphir.Frontend.FSharp.Extension.fsproj" />
    <ProjectReference Include="..\..\src\Morphir.Conformance\Morphir.Conformance.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test data files -->
    <None Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!--
      The pinned WASM profile contract, crafted corpus and modules, for the configured-module loader; see
      ../Fixtures/MepWasm/PROVENANCE.md. IfDifferent, as in Morphir.Extensions.Wasm.Tests, so restored bytes replace a stale copy.
    -->
    <None Include="../Fixtures/MepWasm/**/*" Link="Fixtures/MepWasm/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="IfDifferent" />
    <Content Include="**/*.feature"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Reqnroll" />
  </ItemGroup>

  <ItemGroup>
    <!-- hiding .gitkeep files in Visual Studio; they are only needed to ensure the existence of the empty folders in git -->
    <None Update="**/.gitkeep" Visible="false" />
  </ItemGroup>

</Project>

