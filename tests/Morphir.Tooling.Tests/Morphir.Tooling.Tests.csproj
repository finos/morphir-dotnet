<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Foundatio.Mediator.Generated</InterceptorsNamespaces>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Morphir.Tooling.Tests</RootNamespace>
    <EnableMicrosoftTestingExtensions>true</EnableMicrosoftTestingExtensions>
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing frameworks -->
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="coverlet.collector" />
    <!-- Explicit reference to force Microsoft.Extensions.Hosting 10.0.0 for WolverineFx 5.8.0 -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <!-- Assertions and verification -->
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Verify.TUnit" />

    <!-- BDD framework -->
    <PackageReference Include="Reqnroll" />
    <PackageReference Include="Reqnroll.TUnit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project under test -->
    <ProjectReference Include="..\..\src\Morphir.Tooling\Morphir.Tooling.csproj" />
    <ProjectReference Include="..\..\src\Morphir.Testing\Morphir.Testing.fsproj" />
    <ProjectReference Include="..\Morphir.TestSupport\Morphir.TestSupport.csproj" />
    <!-- The in-process F# frontend and the MCK corpus, for the compile fold property and the tool path (task 4.6). -->
    <ProjectReference Include="..\..\src\Morphir.Frontend.FSharp\Morphir.Frontend.FSharp.fsproj" />
    <ProjectReference Include="..\..\src\Morphir.Frontend.FSharp.Extension\Morphir.Frontend.FSharp.Extension.fsproj" />
    <!-- The external F# backend guest, morphir-fsharp-backend, for the generate extension tests. -->
    <ProjectReference Include="..\..\src\Morphir.CodeGeneration.FSharp.Extension\Morphir.CodeGeneration.FSharp.Extension.fsproj" />
    <ProjectReference Include="..\..\src\Morphir.Conformance\Morphir.Conformance.fsproj" />
    <!-- The scripted fake worker for the mck wasm-host command tests; run from this output with dotnet exec. -->
    <ProjectReference Include="..\Morphir.Conformance.FakeWorker\Morphir.Conformance.FakeWorker.csproj" />
    <ProjectReference Include="../../src/Morphir.Mck/Morphir.Mck.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test data files -->
    <None Include="TestData\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!--
      The pinned WASM profile contract, crafted corpus and modules, for the configured-module loader; see
      ../Fixtures/MepWasm/PROVENANCE.md. IfDifferent, as in Morphir.Extensions.Wasm.Tests, so restored bytes replace a stale copy.
    -->
    <None Include="../Fixtures/MepWasm/**/*" Link="Fixtures/MepWasm/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="IfDifferent" />
    <!-- The worker's own crafted guests (add-wasm-extension-host, task 4.1), shared with the end-to-end tests. -->
    <None Include="../Morphir.E2E.Tests/TestData/Wasm/*" Link="WorkerGuests/%(Filename)%(Extension)" CopyToOutputDirectory="IfDifferent" />
    <Content Include="**/*.feature"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Reqnroll" />
  </ItemGroup>

  <ItemGroup>
    <!-- hiding .gitkeep files in Visual Studio; they are only needed to ensure the existence of the empty folders in git -->
    <None Update="**/.gitkeep" Visible="false" />
  </ItemGroup>

  <Target Name="CopyDevelopmentMckRuntime" AfterTargets="Build">
    <MSBuild Projects="../../src/Morphir.Mck/Morphir.Mck.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_DevelopmentMckTarget" />
    </MSBuild>
    <PropertyGroup>
      <_DevelopmentMckDirectory>$([System.IO.Path]::GetDirectoryName('%(_DevelopmentMckTarget.Identity)'))</_DevelopmentMckDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_DevelopmentMckRuntime Include="$(_DevelopmentMckDirectory)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DevelopmentMckRuntime)"
          DestinationFiles="@(_DevelopmentMckRuntime->'$(OutDir)DevelopmentMck/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

