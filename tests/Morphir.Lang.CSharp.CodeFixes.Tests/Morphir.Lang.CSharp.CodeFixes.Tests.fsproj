<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
        <RootNamespace>Morphir.Lang.CSharp.CodeFixes.Tests</RootNamespace>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <GenerateProgramFile>false</GenerateProgramFile>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Basic.Reference.Assemblies.Net100" />
        <PackageReference Include="Expecto" />
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" />
        <PackageReference Include="coverlet.collector">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Morphir.Lang.CSharp.CodeFixes\Morphir.Lang.CSharp.CodeFixes.csproj" />
        <ProjectReference Include="..\..\src\Morphir.Lang.CSharp.Analyzers\Morphir.Lang.CSharp.Analyzers.csproj" />
        <ProjectReference Include="..\..\src\Morphir.Lang.CSharp.Attributes\Morphir.Lang.CSharp.Attributes.csproj" />
        <!-- The frontend reads the fixed source: the fix keeps the custom type. -->
        <ProjectReference Include="..\..\src\Morphir.Lang.CSharp\Morphir.Lang.CSharp.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="CodeFixSupport.fs" />
        <Compile Include="OlderSumTypeCodeFixTests.fs" />
        <Compile Include="ClosureTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

</Project>
