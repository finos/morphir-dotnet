<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>15</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot Condition="'$(MorphirProbeAot)' == 'true'">true</PublishAot>
    <StripSymbols Condition="'$(MorphirProbeAot)' == 'true'">true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Morphir.SDK.CSharp/Morphir.SDK.CSharp.csproj" />
  </ItemGroup>
</Project>
