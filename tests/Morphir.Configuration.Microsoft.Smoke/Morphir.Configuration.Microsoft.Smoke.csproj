<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The trim and AOT analyzers run in every build. A trimmed or Native AOT publish passes -p:PublishTrimmed or -p:PublishAot (README.md); set in the project, PublishTrimmed would add the host's RID to packages.lock.json. -->
    <IsAotCompatible>true</IsAotCompatible>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <ProjectReference Include="../../src/Morphir.Configuration.Microsoft/Morphir.Configuration.Microsoft.csproj" />
  </ItemGroup>
</Project>
