<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The kernel proof of the add-wasm-extension-host change (task 2.2, design KPF-1): the embedded
    Extism kernel and a published Extism guest in one Wasmtime store, under Native AOT, and a whole
    MEP host session through the WASM channel (task 3.1).
    Publish with: dotnet publish -c Release -r <rid> -p:MorphirProbeAot=true
    Add -p:MorphirWasmtimeStaticLink=true to link the engine into the executable from the pinned Wasmtime C API
    archive in place of the package's dynamic library beside it (task 5.1; ../../build/wasmtime/). It is off by
    default, and .github/workflows/wasm-engine-static-link.yml tries it on each of the six platforms.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <!-- The FSharp.Core summary baseline of tests/Morphir.Mep.AotProbe: Morphir.Mep brings in FSharp.Core. The lines stay in the publish log, and the probe's claim 1 fails on every other IL line. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot Condition="'$(MorphirProbeAot)' == 'true'">true</PublishAot>
    <StripSymbols Condition="'$(MorphirProbeAot)' == 'true'">true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Morphir.Extensions.Wasm/Morphir.Extensions.Wasm.csproj" />
  </ItemGroup>
  <Import Project="../../build/wasmtime/WasmtimeStaticLink.targets" Condition="'$(MorphirWasmtimeStaticLink)' == 'true'" />
</Project>
