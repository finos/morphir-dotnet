<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot Condition="'$(MorphirProbeAot)' == 'true'">true</PublishAot>
    <StripSymbols Condition="'$(MorphirProbeAot)' == 'true'">true</StripSymbols>
    <!-- The Native AOT lane inspects compiler warnings and allows only the FSharp.Core summaries. -->
    <IlcTreatWarningsAsErrors Condition="'$(MorphirProbeAot)' == 'true'">false</IlcTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Morphir.Diagrams/Morphir.Diagrams.fsproj" />
    <ProjectReference Include="../../src/Morphir.Diagrams.Query/Morphir.Diagrams.Query.fsproj" />
    <ProjectReference Include="../../src/Morphir.Diagrams.Raster/Morphir.Diagrams.Raster.fsproj" />
    <ProjectReference Include="../../src/Morphir.Diagrams.Canvas/Morphir.Diagrams.Canvas.fsproj" />
  </ItemGroup>
</Project>
