<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The trim and AOT analyzers run in every build. A trimmed or Native AOT publish passes -p:PublishTrimmed or -p:PublishAot (README.md); set in the project, PublishTrimmed would add the host's RID to packages.lock.json. -->
    <IsAotCompatible>true</IsAotCompatible>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Morphir.Configuration.IO/Morphir.Configuration.IO.csproj" />
    <Compile Include="../../src/Morphir.Tooling/Features/Configuration/ConfigurationReport.cs" Link="ConfigurationReport.cs" />
    <Compile Include="../../src/Morphir.Tooling/Features/Configuration/ConfigurationEditReport.cs" Link="ConfigurationEditReport.cs" />
    <Compile Include="../../src/Morphir.Tooling/Features/ProjectMigration/ProjectMigrationReport.cs" Link="ProjectMigrationReport.cs" />
    <Compile Include="../../src/Morphir.Tooling/Features/WorkspaceMigration/WorkspaceMigrationReport.cs" Link="WorkspaceMigrationReport.cs" />
  </ItemGroup>
</Project>
