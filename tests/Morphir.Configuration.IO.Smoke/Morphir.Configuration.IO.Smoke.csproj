<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishTrimmed>true</PublishTrimmed>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Morphir.Configuration.IO/Morphir.Configuration.IO.csproj" />
    <Compile Include="../../src/Morphir.Tooling/Features/Configuration/ConfigurationReport.cs" Link="ConfigurationReport.cs" />
    <Compile Include="../../src/Morphir.Tooling/Features/Configuration/ConfigurationEditReport.cs" Link="ConfigurationEditReport.cs" />
    <Compile Include="../../src/Morphir.Tooling/Features/ProjectMigration/ProjectMigrationReport.cs" Link="ProjectMigrationReport.cs" />
    <Compile Include="../../src/Morphir.Tooling/Features/WorkspaceMigration/WorkspaceMigrationReport.cs" Link="WorkspaceMigrationReport.cs" />
  </ItemGroup>
</Project>
