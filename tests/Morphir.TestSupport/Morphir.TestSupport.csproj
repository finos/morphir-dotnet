<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared, framework-neutral test infrastructure: sandboxes, child processes and cleanup.
       Never packed or shipped. -->
  <PropertyGroup>
    <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Morphir.TestSupport</RootNamespace>
  </PropertyGroup>

</Project>