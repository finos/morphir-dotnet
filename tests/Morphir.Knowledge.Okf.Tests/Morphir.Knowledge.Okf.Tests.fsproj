<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
        <GenerateProgramFile>false</GenerateProgramFile>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Expecto" />
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Morphir.Knowledge.Okf/Morphir.Knowledge.Okf.fsproj" />
        <ProjectReference Include="../Morphir.TestSupport/Morphir.TestSupport.csproj" />
    </ItemGroup>
    <ItemGroup>
        <Compile Include="DocumentTests.fs" />
        <Compile Include="BundleTests.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>
</Project>
