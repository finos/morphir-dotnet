<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(MorphirCurrentTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Morphir.TestSupport.Tests</RootNamespace>
    <EnableMicrosoftTestingExtensions>true</EnableMicrosoftTestingExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Morphir.TestSupport/Morphir.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fixture files for the workspace and driver tests. -->
    <None Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The README of the library, for the test that keeps its names equal to the code. -->
    <None Include="../Morphir.TestSupport/README.md" Link="Fixtures/TestSupport.README.md" CopyToOutputDirectory="PreserveNewest" />
    <!-- Real models for the tests that start the CLI. -->
    <None Include="../Morphir.Tooling.Tests/TestData/valid-ir-v3.json" Link="Fixtures/Cli/valid-ir-v3.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Morphir.Tooling.Tests/TestData/invalid-missing-formatversion.json" Link="Fixtures/Cli/invalid-missing-formatversion.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../examples/car-rental/models/car-rental-v3.json" Link="Fixtures/Cli/car-rental-v3.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The CLI entry points of the development build, for the real-process tests of the CLI driver. -->
  <Import Project="../Morphir.TestSupport/build/Morphir.CliArtifacts.targets" />
  <!-- The extension guests of the development build, for the tests of the extension driver. -->
  <Import Project="../Morphir.TestSupport/build/Morphir.ExtensionArtifacts.targets" />

</Project>