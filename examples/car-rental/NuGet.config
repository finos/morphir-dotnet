<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Morphir.Myriad comes from NuGet.org; this file only keeps the repository's source mapping out of the example. -->
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
