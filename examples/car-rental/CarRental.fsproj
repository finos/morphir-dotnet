<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <MorphirMyriadVersion Condition="'$(MorphirMyriadVersion)' == ''">0.4.0-alpha.2</MorphirMyriadVersion>
    <MorphirModelFile Condition="'$(MorphirModelFile)' == ''">models/car-rental-v3.json</MorphirModelFile>
    <!-- The user chooses the Morphir.Myriad release, so a lock file would pin one version for everyone. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Morphir.Myriad" VersionOverride="[$(MorphirMyriadVersion)]" PrivateAssets="all" />
    <PackageReference Include="FSharp.Core" />
    <MorphirModel Include="$(MorphirModelFile)" />
    <Compile Include="Program.fs" />
  </ItemGroup>
</Project>
