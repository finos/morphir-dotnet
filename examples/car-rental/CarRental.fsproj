<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <MorphirModelFile Condition="'$(MorphirModelFile)' == ''">models/car-rental-v3.json</MorphirModelFile>
    <!-- The user chooses the Morphir.Myriad release, so a lock file would pin one version for everyone. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Morphir.Myriad" VersionOverride="[$(MorphirMyriadVersion)]" PrivateAssets="all" />
    <PackageReference Include="FSharp.Core" />
    <MorphirModel Include="$(MorphirModelFile)" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <Target Name="RequireMorphirMyriadVersion" BeforeTargets="CollectPackageReferences;_GenerateRestoreProjectSpec" Condition="'$(MorphirMyriadVersion)' == ''">
    <Error Text="Set MorphirMyriadVersion to a morphir-dotnet release version on NuGet.org, for example: dotnet run --project examples/car-rental/CarRental.fsproj -p:MorphirMyriadVersion=RELEASE_VERSION" />
  </Target>
</Project>
