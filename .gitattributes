# Auto detect text files
* text=auto

# Custom for Visual Studio
*.cs diff=csharp text=auto eol=lf
*.vb diff=csharp text=auto eol=lf
*.fs diff=csharp text=auto eol=lf
*.fsi diff=csharp text=auto eol=lf
*.fsx diff=csharp text=auto eol=lf
*.sln text eol=crlf merge=union
*.csproj merge=union
*.vbproj merge=union
*.fsproj merge=union
*.dbproj merge=union
*.sh text eol=lf

# Standard to msysgit
*.doc diff=astextplain
*.DOC diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot diff=astextplain
*.DOT diff=astextplain
*.pdf diff=astextplain
*.PDF diff=astextplain
*.rtf diff=astextplain
*.RTF diff=astextplain

# Verify
*.verified.txt text eol=lf working-tree-encoding=UTF-8
*.verified.xml text eol=lf working-tree-encoding=UTF-8
*.verified.json text eol=lf working-tree-encoding=UTF-8
*.verified.bin binary

.editorconfig text eol=lf working-tree-encoding=UTF-8
*.sln.DotSettings text eol=lf working-tree-encoding=UTF-8
*.slnx.DotSettings text eol=lf working-tree-encoding=UTF-8

*NonStandardEncoding* binary

# Keep hash-locked OpenSpec payloads byte-identical on every platform.
openspec/schemas/html-design/** text eol=lf
openspec/extensions.lock.json text eol=lf

# Vendored Morphir Ion fixtures are checked by SHA-256, so their bytes must not change
tests/Fixtures/MorphirIon/** -text

# Preserve original upstream bytes used by the frontend provenance checks.
tests/Fixtures/Mep/** -text
tests/Fixtures/MorphirOut/** -text

# Toolchain acquisition contract fixtures are checked by SHA-256 against finos/morphir; the plan digest fixture
# holds exact canonical bytes, and request identity is the SHA-256 of the exact TOML bytes.
tests/Fixtures/Toolchain/** -text
# Published extension contract blobs are verified offline against their parent Git bytes.
tests/Fixtures/ExtensionAcquisition/parent-0439c4c0/** -text
# The morphirup AOT probe's plan digest covers the SHA-256 of its recipe bytes.
tests/Morphir.Toolchain.Tests/AotProbe/** -text

# The portable case-set digest must not change with checkout newline settings.
conformance/** text eol=lf

# Embedded business fixtures use their checked-in LF bytes for provenance hashes.
examples/car-rental/models/car-rental-v1.json text eol=lf
examples/car-rental/models/car-rental-v2.json text eol=lf
examples/car-rental/models/car-rental-v3.json text eol=lf
tests/Fixtures/MorphirIR/daily-rate-v3.json text eol=lf
tests/Fixtures/MorphirIR/daily-rate-v4.json text eol=lf

# Configuration corpus and schema snapshots are also verified by their raw hashes.
tests/Fixtures/Configuration/** -text

# JSON5 newline grammar fixtures intentionally contain hash-pinned CR/CRLF bytes.
tests/Fixtures/Configuration/json5-tests/new-lines/*.json5 -whitespace
# Unicode conformance data is checked by SHA-256, so its bytes must not change
tests/Fixtures/Unicode/** -text
