# Auto detect text files
* text=auto

# Custom for Visual Studio
*.cs diff=csharp text=auto eol=lf
*.vb diff=csharp text=auto eol=lf
*.fs diff=csharp text=auto eol=lf
*.fsi diff=csharp text=auto eol=lf
*.fsx diff=csharp text=auto eol=lf
*.sln text eol=crlf merge=union
*.csproj merge=union
*.vbproj merge=union
*.fsproj merge=union
*.dbproj merge=union
*.sh text eol=lf

# Standard to msysgit
*.doc diff=astextplain
*.DOC diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot diff=astextplain
*.DOT diff=astextplain
*.pdf diff=astextplain
*.PDF diff=astextplain
*.rtf diff=astextplain
*.RTF diff=astextplain

# Verify
*.verified.txt text eol=lf working-tree-encoding=UTF-8
*.verified.xml text eol=lf working-tree-encoding=UTF-8
*.verified.json text eol=lf working-tree-encoding=UTF-8
*.verified.bin binary

.editorconfig text eol=lf working-tree-encoding=UTF-8
*.sln.DotSettings text eol=lf working-tree-encoding=UTF-8
*.slnx.DotSettings text eol=lf working-tree-encoding=UTF-8

*NonStandardEncoding* binary

# Keep hash-locked OpenSpec payloads byte-identical on every platform.
openspec/schemas/html-design/** text eol=lf
openspec/extensions.lock.json text eol=lf

# Vendored Morphir Ion fixtures are checked by SHA-256, so their bytes must not change
tests/Fixtures/MorphirIon/** -text

# Preserve original upstream bytes used by the frontend provenance checks.
tests/Fixtures/Mep/** -text
tests/Fixtures/MorphirOut/** -text
tests/Fixtures/MepWasm/** -text
tests/Fixtures/MepGuestKit/** -text

# Toolchain acquisition contract fixtures are checked by SHA-256 against finos/morphir; the plan digest fixture
# holds exact canonical bytes, and request identity is the SHA-256 of the exact TOML bytes.
tests/Fixtures/Toolchain/** -text
tests/Fixtures/LocalToolchains/** -text
# Published extension contract blobs are verified offline against their parent Git bytes.
tests/Fixtures/ExtensionAcquisition/parent-65bbbc96/** -text
# The morphirup AOT probe's plan digest covers the SHA-256 of its recipe bytes.
tests/Morphir.Toolchain.Tests/AotProbe/** -text

# The portable case-set digest must not change with checkout newline settings.
conformance/** text eol=lf

# Embedded business fixtures use their checked-in LF bytes for provenance hashes.
examples/car-rental/models/car-rental-v1.json text eol=lf
examples/car-rental/models/car-rental-v2.json text eol=lf
examples/car-rental/models/car-rental-v3.json text eol=lf
tests/Fixtures/MorphirIR/daily-rate-v3.json text eol=lf
tests/Fixtures/MorphirIR/daily-rate-v4.json text eol=lf

# Configuration corpus and schema snapshots are also verified by their raw hashes.
tests/Fixtures/Configuration/** -text

# JSON5 newline grammar fixtures intentionally contain hash-pinned CR/CRLF bytes.
tests/Fixtures/Configuration/json5-tests/new-lines/*.json5 -whitespace
# Unicode conformance data is checked by SHA-256, so its bytes must not change
tests/Fixtures/Unicode/** -text
src/Morphir.Extensions.Installation/TrustedRoots/*.pem -text
# Third-party license texts that the release notices insert: LF on every checkout.
build/notices/*.txt text eol=lf
build/notices/native/*.txt text eol=lf
# Their bytes must equal the release notices' copies in build/notices: LF on every checkout.
src/Morphir.Extensions.Wasm/Kernel/LICENSE text eol=lf
src/Morphir.Extensions.Wasm/Kernel/NOTICE text eol=lf
# Document-tree kit data from finos/morphir, checked by SHA-256 (tests/Fixtures/MorphirTrees/PROVENANCE.md).
tests/Fixtures/MorphirTrees/** -text
# Bounded-generation receipts, schema and controls use the exact finos/morphir Git blobs.
tests/Fixtures/MorphirBoundedGenerationReceipts/** -text
# The IR fixtures that FixtureCatalog serves are checked by SHA-256, so their bytes are the same on every checkout.
tests/Fixtures/MorphirIR/greeting-example-v3.json -text
tests/Fixtures/MorphirIR/constant-folding-v3.json text eol=lf
tests/Fixtures/MorphirIR/constant-folding-v4.json text eol=lf
tests/Fixtures/MorphirIR/daily-rate-mismatch-v3.json text eol=lf
tests/Fixtures/MorphirIR/malformed-model.txt text eol=lf
tests/Fixtures/MorphirIR/empty-library-v1.json text eol=lf
tests/Fixtures/MorphirIR/empty-library-v2.json text eol=lf
tests/Fixtures/MorphirIR/no-format-version.json text eol=lf
tests/Fixtures/MorphirIR/string-format-version.json text eol=lf
tests/Fixtures/MorphirIR/daily-rate-unknown-type-tag-v4.json text eol=lf
tests/Fixtures/MorphirIR/specs-v3.json -text
tests/Fixtures/MorphirIR/specs-unknown-member-v3.json -text

# The IR v4 schemas and the IR 3.1.0 schema of finos/morphir, pinned byte for byte (src/Morphir.Tooling/Infrastructure/Schemas/PROVENANCE.md).
src/Morphir.Tooling/Infrastructure/Schemas/morphir-ir-v4.json -text
src/Morphir.Tooling/Infrastructure/Schemas/morphir-ir-v4-document-tree-files.json -text
src/Morphir.Tooling/Infrastructure/Schemas/morphir-ir-v3.1.0.json -text

# RFC 8785 as the RFC Editor publishes it, the source of the JCS test vectors (tests/Fixtures/Rfc8785/PROVENANCE.md).
tests/Fixtures/Rfc8785/** -text
# Morphir file context data from finos/morphir, checked by SHA-256 (tests/Fixtures/MorphirContext/PROVENANCE.md).
tests/Fixtures/MorphirContext/** -text
