;; Test host for morphir-bytes-v1, preloaded by the wasmtime CLI as the
;; module "morphir_bytes_v1". It holds one request in its memory and writes
;; each output byte to stdout through WASI fd_write.
(module
  (import "wasi_snapshot_preview1" "fd_write"
    (func $fd_write (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 1024) "@REQUEST@")
  (func (export "input_len") (result i32) (i32.const @LEN@))
  (func (export "input_byte") (param $i i32) (result i32)
    (i32.load8_u (i32.add (i32.const 1024) (local.get $i))))
  (func (export "output_byte") (param $b i32)
    (i32.store8 (i32.const 16) (local.get $b))
    (i32.store (i32.const 0) (i32.const 16))
    (i32.store (i32.const 4) (i32.const 1))
    (drop (call $fd_write (i32.const 1) (i32.const 0) (i32.const 1) (i32.const 8)))))
