<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Wasmtime probe as a RID-specific framework-dependent dotnet tool
    (.NET 10 SDK). Pack makes one pointer package and one package for each RID.
  -->
  <PropertyGroup>
    <RuntimeIdentifier></RuntimeIdentifier>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64;win-x64;win-arm64</RuntimeIdentifiers>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>probe-rid</ToolCommandName>
    <PackageId>Spike.WasmProbe.Rid</PackageId>
    <Version>0.0.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../WasmtimeProbe/Program.cs" Link="Program.cs" />
    <PackageReference Include="Wasmtime" Version="50.0.1" />
  </ItemGroup>
</Project>
