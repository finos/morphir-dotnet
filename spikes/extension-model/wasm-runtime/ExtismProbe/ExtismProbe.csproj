<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ExtismStatic=true links libextism.a from the Extism release
    (libextism-aarch64-apple-darwin-v1.13.0.tar.gz) into the Native AOT binary.
    Pass the path with -p:ExtismStaticLib=<path to libextism.a>.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Extism.Sdk" Version="1.10.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(ExtismStatic)' != 'true'">
    <PackageReference Include="Extism.runtime.osx-arm64" Version="1.13.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(ExtismStatic)' == 'true'">
    <DirectPInvoke Include="extism" />
    <NativeLibrary Include="$(ExtismStaticLib)" />
  </ItemGroup>
</Project>
