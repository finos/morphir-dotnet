<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike: how Roslyn shows a C# 15 union to a frontend. See docs/content/contributing/design/spikes/csharp-language-support.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- The inputs are data for the probe, not sources of the probe. -->
    <Compile Remove="inputs/**" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>
</Project>
