<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike: a project that takes the generator as an analyzer. Build the Generator project first; see ../README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>generated</CompilerGeneratedFilesOutputPath>
    <GeneratorDir Condition="'$(GeneratorDir)' == ''">$(MSBuildThisFileDirectory)../Generator/bin/Release/netstandard2.0</GeneratorDir>
  </PropertyGroup>
  <!-- The generated code calls the C# SDK of the repository. MorphirSdkDll gives a built assembly, for a copy outside the repository. -->
  <ItemGroup Condition="'$(MorphirSdkDll)' == ''">
    <ProjectReference Include="../../../../src/Morphir.SDK.CSharp/Morphir.SDK.CSharp.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(MorphirSdkDll)' != ''">
    <Reference Include="$(MorphirSdkDll)" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="car-rental.morphir.json" />
    <Analyzer Include="$(GeneratorDir)/*.dll" Exclude="$(GeneratorDir)/Microsoft.CodeAnalysis*.dll" />
    <Compile Remove="generated/**" />
  </ItemGroup>
</Project>
